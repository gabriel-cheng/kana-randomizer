<link rel="stylesheet" href="/css/chart-modal.css">
<div class="chart-modal" id="chartModal" data-default-alphabet="{{#if alphabet}}{{alphabet}}{{else}}hiragana{{/if}}" hidden>
    <div class="chart-modal-overlay" id="chartModalOverlay"></div>
    <div class="chart-modal-panel" role="dialog" aria-modal="true" aria-labelledby="chartModalTitle">
        <div class="chart-modal-header">
            <h2 id="chartModalTitle">Tabela completa</h2>
            <button type="button" class="chart-modal-close" id="chartModalClose" aria-label="Fechar tabela completa">&times;</button>
        </div>

        <div class="chart-modal-tabs" role="tablist" aria-label="Escolha o alfabeto">
            <button type="button" class="chart-tab" id="chartTabHiragana" role="tab" data-alphabet="hiragana">Hiragana</button>
            <button type="button" class="chart-tab" id="chartTabKatakana" role="tab" data-alphabet="katakana">Katakana</button>
        </div>

        <div class="chart-modal-body" id="chartModalBody"></div>
    </div>
</div>
<script>
    (function () {
        var HIRAGANA = {
            seion: [
                ["あ","a"],["い","i"],["う","u"],["え","e"],["お","o"],
                ["か","ka"],["き","ki"],["く","ku"],["け","ke"],["こ","ko"],
                ["さ","sa"],["し","shi"],["す","su"],["せ","se"],["そ","so"],
                ["た","ta"],["ち","chi"],["つ","tsu"],["て","te"],["と","to"],
                ["な","na"],["に","ni"],["ぬ","nu"],["ね","ne"],["の","no"],
                ["は","ha"],["ひ","hi"],["ふ","fu"],["へ","he"],["ほ","ho"],
                ["ま","ma"],["み","mi"],["む","mu"],["め","me"],["も","mo"],
                ["や","ya"],null,["ゆ","yu"],null,["よ","yo"],
                ["ら","ra"],["り","ri"],["る","ru"],["れ","re"],["ろ","ro"],
                ["わ","wa"],null,null,null,["を","wo"],
                ["ん","n"]
            ],
            dakuten: [
                ["が","ga"],["ぎ","gi"],["ぐ","gu"],["げ","ge"],["ご","go"],
                ["ざ","za"],["じ","ji"],["ず","zu"],["ぜ","ze"],["ぞ","zo"],
                ["だ","da"],["ぢ","ji"],["づ","zu"],["で","de"],["ど","do"],
                ["ば","ba"],["び","bi"],["ぶ","bu"],["べ","be"],["ぼ","bo"]
            ],
            handakuten: [
                ["ぱ","pa"],["ぴ","pi"],["ぷ","pu"],["ぺ","pe"],["ぽ","po"]
            ],
            yoon: [
                ["きゃ","kya"],["きゅ","kyu"],["きょ","kyo"],
                ["しゃ","sha"],["しゅ","shu"],["しょ","sho"],
                ["ちゃ","cha"],["ちゅ","chu"],["ちょ","cho"],
                ["にゃ","nya"],["にゅ","nyu"],["にょ","nyo"],
                ["ひゃ","hya"],["ひゅ","hyu"],["ひょ","hyo"],
                ["みゃ","mya"],["みゅ","myu"],["みょ","myo"],
                ["りゃ","rya"],["りゅ","ryu"],["りょ","ryo"],
                ["ぎゃ","gya"],["ぎゅ","gyu"],["ぎょ","gyo"],
                ["じゃ","ja"],["じゅ","ju"],["じょ","jo"],
                ["びゃ","bya"],["びゅ","byu"],["びょ","byo"],
                ["ぴゃ","pya"],["ぴゅ","pyu"],["ぴょ","pyo"]
            ]
        };

        var KATAKANA = {
            seion: [
                ["ア","a"],["イ","i"],["ウ","u"],["エ","e"],["オ","o"],
                ["カ","ka"],["キ","ki"],["ク","ku"],["ケ","ke"],["コ","ko"],
                ["サ","sa"],["シ","shi"],["ス","su"],["セ","se"],["ソ","so"],
                ["タ","ta"],["チ","chi"],["ツ","tsu"],["テ","te"],["ト","to"],
                ["ナ","na"],["ニ","ni"],["ヌ","nu"],["ネ","ne"],["ノ","no"],
                ["ハ","ha"],["ヒ","hi"],["フ","fu"],["ヘ","he"],["ホ","ho"],
                ["マ","ma"],["ミ","mi"],["ム","mu"],["メ","me"],["モ","mo"],
                ["ヤ","ya"],null,["ユ","yu"],null,["ヨ","yo"],
                ["ラ","ra"],["リ","ri"],["ル","ru"],["レ","re"],["ロ","ro"],
                ["ワ","wa"],null,null,null,["ヲ","wo"],
                ["ン","n"]
            ],
            dakuten: [
                ["ガ","ga"],["ギ","gi"],["グ","gu"],["ゲ","ge"],["ゴ","go"],
                ["ザ","za"],["ジ","ji"],["ズ","zu"],["ゼ","ze"],["ゾ","zo"],
                ["ダ","da"],["ヂ","ji"],["ヅ","zu"],["デ","de"],["ド","do"],
                ["バ","ba"],["ビ","bi"],["ブ","bu"],["ベ","be"],["ボ","bo"]
            ],
            handakuten: [
                ["パ","pa"],["ピ","pi"],["プ","pu"],["ペ","pe"],["ポ","po"]
            ],
            yoon: [
                ["キャ","kya"],["キュ","kyu"],["キョ","kyo"],
                ["シャ","sha"],["シュ","shu"],["ショ","sho"],
                ["チャ","cha"],["チュ","chu"],["チョ","cho"],
                ["ニャ","nya"],["ニュ","nyu"],["ニョ","nyo"],
                ["ヒャ","hya"],["ヒュ","hyu"],["ヒョ","hyo"],
                ["ミャ","mya"],["ミュ","myu"],["ミョ","myo"],
                ["リャ","rya"],["リュ","ryu"],["リョ","ryo"],
                ["ギャ","gya"],["ギュ","gyu"],["ギョ","gyo"],
                ["ジャ","ja"],["ジュ","ju"],["ジョ","jo"],
                ["ビャ","bya"],["ビュ","byu"],["ビョ","byo"],
                ["ピャ","pya"],["ピュ","pyu"],["ピョ","pyo"]
            ]
        };

        var DATA = { hiragana: HIRAGANA, katakana: KATAKANA };
        var SECTION_LABELS = {
            seion: "Básico (seion)",
            dakuten: "Sons sonoros (dakuten)",
            handakuten: "Sons semi-sonoros (handakuten)",
            yoon: "Combinações (yōon)"
        };
        var SECTION_COLS = { seion: 5, dakuten: 5, handakuten: 5, yoon: 3 };

        var modal = document.querySelector("#chartModal");
        var overlay = document.querySelector("#chartModalOverlay");
        var closeBtn = document.querySelector("#chartModalClose");
        var openBtn = document.querySelector("#openChartModalBtn");
        var body = document.querySelector("#chartModalBody");
        var tabs = document.querySelectorAll(".chart-tab");
        var lastFocusedElement = null;

        function renderChart(alphabetKey) {
            var data = DATA[alphabetKey];
            if (!data) return;

            body.innerHTML = "";

            Object.keys(data).forEach(function (sectionKey) {
                var section = document.createElement("section");
                section.className = "chart-section";

                var heading = document.createElement("h3");
                heading.textContent = SECTION_LABELS[sectionKey];
                section.appendChild(heading);

                var grid = document.createElement("div");
                grid.className = "chart-grid";
                grid.style.setProperty("--chart-cols", SECTION_COLS[sectionKey]);

                data[sectionKey].forEach(function (entry) {
                    var cell = document.createElement("div");
                    if (!entry) {
                        cell.className = "chart-cell chart-cell-empty";
                        grid.appendChild(cell);
                        return;
                    }
                    cell.className = "chart-cell";
                    var kana = document.createElement("span");
                    kana.className = "chart-kana";
                    kana.textContent = entry[0];
                    var romaji = document.createElement("span");
                    romaji.className = "chart-romaji";
                    romaji.textContent = entry[1];
                    cell.appendChild(kana);
                    cell.appendChild(romaji);
                    grid.appendChild(cell);
                });

                section.appendChild(grid);
                body.appendChild(section);
            });
        }

        function setActiveTab(alphabetKey) {
            tabs.forEach(function (tab) {
                var isActive = tab.dataset.alphabet === alphabetKey;
                tab.classList.toggle("chart-tab-active", isActive);
                tab.setAttribute("aria-selected", String(isActive));
            });
            renderChart(alphabetKey);
        }

        tabs.forEach(function (tab) {
            tab.addEventListener("click", function () {
                setActiveTab(tab.dataset.alphabet);
            });
        });

        function openModal() {
            lastFocusedElement = document.activeElement;
            modal.hidden = false;
            document.body.classList.add("no-scroll");
            setActiveTab(modal.dataset.defaultAlphabet === "katakana" ? "katakana" : "hiragana");
            closeBtn.focus();
        }

        function closeModal() {
            modal.hidden = true;
            document.body.classList.remove("no-scroll");
            if (lastFocusedElement) lastFocusedElement.focus();
        }

        if (openBtn) {
            openBtn.addEventListener("click", openModal);
        }

        closeBtn.addEventListener("click", closeModal);
        overlay.addEventListener("click", closeModal);

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && !modal.hidden) {
                closeModal();
            }
        });
    })();
</script>
