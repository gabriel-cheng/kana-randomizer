<link rel="stylesheet" href="/css/header.css">
<header id="header-container">
    <div class="header-subcontainer">
        <div class="header-icone">
            <a href="/" aria-label="Ir para a página inicial">
                <img src="/images/icons/sakura100x100.png" alt="Kana Randomizer">
            </a>
        </div>
        <nav aria-label="Navegação principal">
            <ul class="header-list">
                <li>
                    <a class="header-item" href="/hiragana">Hiragana</a>
                </li>
                <li>
                    <a class="header-item" href="/katakana">Katakana</a>
                </li>
            </ul>
        </nav>
    </div>
</header>
<script>
    (function () {
        var currentPath = window.location.pathname.replace(/\/$/, "") || "/";
        document.querySelectorAll(".header-item").forEach(function (link) {
            var linkPath = link.getAttribute("href").replace(/\/$/, "") || "/";
            if (linkPath === currentPath) {
                link.classList.add("header-item-active");
                link.setAttribute("aria-current", "page");
            }
        });
    })();
</script>