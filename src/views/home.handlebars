<link rel="stylesheet" href="/css/home.css">
<main id="home-container" class="parallax-background" style="background-image: url('/images/backgrounds/background1.jpg')">
    <div class="fume-container home-subcontainer">
        <div class="home-title-container">
            <h1>Japanese <span>Kana</span> Randomizer</h1>
            <div class="home-title-line"></div>
            <h2>Escolha o alfabeto que deseja praticar:</h2>
        </div>
        <div class="box-container">
            <a class="box box1" href="/hiragana" aria-label="Praticar Hiragana">
                <div class="box-subcontainer">
                    <div class="box-character-container" aria-hidden="true">
                        <h1>あ</h1>
                    </div>
                    <div class="box-items-container">
                        <div class="box-title-container">
                            <h1>Hiragana</h1>
                        </div>
                        <div class="box-subtitle-container">
                            <p>Silabário Hiragana</p>
                        </div>
                        <div class="box-button-container">
                            <span class="box-button">Selecionar</span>
                        </div>
                    </div>
                </div>
            </a>
            <a class="box box2" href="/katakana" aria-label="Praticar Katakana">
                <div class="box-subcontainer">
                    <div class="box-character-container" aria-hidden="true">
                        <h1>ア</h1>
                    </div>
                    <div class="box-items-container">
                        <div class="box-title-container">
                            <h1>Katakana</h1>
                        </div>
                        <div class="box-subtitle-container">
                            <p>Silabário Katakana</p>
                        </div>
                        <div class="box-button-container">
                            <span class="box-button">Selecionar</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</main>